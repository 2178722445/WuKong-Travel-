# PostgreSQL / PostGIS 数据库连接
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wukong_travel"

# 数据库单独配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wukong_travel
DB_USER=postgres
DB_PASSWORD=postgres

# JWT 签名密钥 (生产环境请更换为随机字符串)
SECRET_KEY="wukong-travel-secret-key-2026"

# 服务端口
PORT=3721

# CORS 允许的前端地址
CORS_ORIGINS="http://localhost:5173"

# Cesium Ion Token (注册获取: https://ion.cesium.com/)
VITE_CESIUM_ION_TOKEN="your_cesium_ion_token_here"
